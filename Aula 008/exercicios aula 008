Código 5 - Rust

fn dobra(v: &Vec<i32>) -> Vec<i32> {
    v.iter().map(|x| x * 2).collect()
}

fn main(){
    let v = vec![1, 2, 3];
    let d = dobra(&v);
    println!("{:?} {:?}", v, d);
}

saída: [1, 2, 3] [2, 4, 6]
conceito da aula: modo de passagem por posse (move)

